# 복사해서 .env.local (개발) 또는 .env.production (앱 빌드) 로 쓰세요. 두 파일은 git 에 올리지 않아요.

# [개발] npm run dev 가 /api 를 넘길 스프링 서버 주소 (Tomcat 컨텍스트 경로까지. 이클립스 웹 주소가 /ItGEO 처럼 다르면 그 경로로)
VITE_SERVER=http://localhost:8080/itgeo

# [앱] 폰에서 접속할 스프링 서버 주소 (Tomcat 컨텍스트 경로까지)
#   - 클라우드 서버 (deploy/setup-server.sh 로 설치한 경우)  예: https://it-geo.duckdns.org/itgeo
#   - 같은 와이파이의 PC 로 테스트할 때는 PC 의 IP          예: http://192.168.0.10:8080/itgeo
# VITE_API_BASE=https://it-geo.duckdns.org/itgeo
